# Copy to .env and fill in. Never commit .env.
ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL_SECONDS=86400
# memory:// = built-in in-process store, no Redis or Docker needed (single worker). Use redis://host:6379/0 in production.
REDIS_URL=memory://
SESSION_TTL_SECONDS=1800
# Local: a SQLite file (no server). Production: your Postgres URL, e.g. postgresql://user:pass@host:5432/db?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./agroai.db
KNOWLEDGE_REFRESH_SECONDS=300
# Comma-separated exact browser origins allowed to call the API (CORS). Never * in production.
ALLOWED_ORIGINS=http://localhost:5173

# gemini | anthropic  (gemini has a free tier: https://aistudio.google.com/apikey). Real AI only.
VISION_PROVIDER=gemini
# Weather is always real: Open-Meteo (free, no key)
WEATHER_PROVIDER=open_meteo
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-5-5
ANTHROPIC_REFUSAL_FALLBACK=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Global cap on paid AI calls per UTC day (every model call counts). 429 with Retry-After once reached.
DAILY_AI_CALL_LIMIT=200
MAX_IMAGE_BYTES=5242880

# Rate limits (fixed windows). Defaults suit one farmer per device; tune for a busy demo.
RATE_DEVICE_PER_MINUTE=60
RATE_IP_PER_MINUTE=120
RATE_DIAGNOSE_DEVICE_PER_HOUR=20
RATE_DIAGNOSE_IP_PER_HOUR=100
RATE_CHAT_DEVICE_PER_HOUR=60
RATE_CHAT_IP_PER_HOUR=300
RATE_ANON_IP_PER_HOUR=60
# Number of reverse proxies in front of the API (Render/Railway/Fly = 1) so per-IP limits see the real client
TRUSTED_PROXY_HOPS=0
