{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand":"cd web && npm install --no-audit --no-fund",
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/dist",
  "build": { "env": { "VITE_API_BASE": "" } },
  "functions": {
    "api/index.py": { "maxDuration": 60, "includeFiles": "backend/app/**" }
  },
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/index" }
  ]
}
